# ---- LLM (셋 중 하나) ----
# 1) 아주LLM BAZE API Gateway 키 (우선 사용). BAZE 좌측 하단 "API Gateway"에서 발급.
BAZE_API_KEY=
# BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/claude
# 2) Anthropic API 키
ANTHROPIC_API_KEY=
# 3) 둘 다 비우면 규칙 기반 태깅 + 템플릿 인사이트 (비용 0)

# 태깅은 짧은 분류라 Haiku로 충분 (Sonnet 대비 약 1/20 비용). BAZE에서 ID가 다르면 check_llm 이 후보를 알려 줌
TAG_MODEL=claude-haiku-5-5
INSIGHT_MODEL=claude-opus-5-5

# ---- 토큰 절약 ----
# 공지 갱신은 기본적으로 사용자가 "공지 새로고침"을 누를 때만 한다. 1로 켜면 주기적으로 자동 수집.
AUTO_CRAWL=0
CRAWL_INTERVAL_MIN=180
# 1로 켜면 매일 INSIGHT_HOUR_KST시에 모든 사용자 인사이트 생성. 0이면 사용자가 인사이트 탭을 열 때 하루 1회 생성.
AUTO_INSIGHT=0
INSIGHT_HOUR_KST=7
# LLM 태깅 대상: 최근 N일 공지만, 한 번 갱신에 최대 M건 (태깅은 공지당 평생 1회, 결과는 캐시)
LLM_TAG_MAX_AGE_DAYS=45
LLM_TAG_MAX_PER_RUN=100
# 수집 제외 게시판 id (쉼표 구분). 기본: 아주대학보(칼럼·보도 위주)
EXCLUDED_SOURCES=press_rss
REQUEST_DELAY_SEC=1.0
MAX_DETAIL_FETCH_PER_RUN=150
